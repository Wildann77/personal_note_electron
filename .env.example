# ==============================================================================
# Personal Note Desktop App — Environment Variables Template
# Copy this file to .env for local development:
#   cp .env.example .env
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# GitHub Releases Update Checker (Architecture §15.3, PRD US#61)
GITHUB_OWNER=Wildann77
GITHUB_REPO=personal_note_electron

# Build & Vite Configuration
VITE_CONFIG_NATIVE_IGNORE_WARNING=true

# macOS Code Signing & Notarization (Optional, for packaging on macOS)
# APPLE_CERTIFICATE=
# APPLE_ID=
# APPLE_PASSWORD=
# APPLE_TEAM_ID=
